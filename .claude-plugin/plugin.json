{
  "name": "codex-attachment-manager",
  "displayName": "Context Attachment Manager",
  "version": "0.4.0",
  "description": "Choose which images from a Claude Code session's history go out with the next message. Unchecked images become short placeholders; the session and the conversation stay the same.",
  "author": {
    "name": "chipfighter"
  },
  "homepage": "https://github.com/chipfighter/context-attachment-manager",
  "repository": "https://github.com/chipfighter/context-attachment-manager",
  "license": "MIT",
  "keywords": ["images", "context", "attachments", "proxy"],
  "mcpServers": {
    "codex_attachment_manager": {
      "command": "${CLAUDE_PLUGIN_ROOT}/plugin/scripts/launch",
      "args": ["${CLAUDE_PLUGIN_ROOT}/plugin/src/plugin-server.ts"],
      "env": {
        "CAM_HOST": "claude"
      }
    }
  },
  "types": "./hooks/types.d.ts"
}
